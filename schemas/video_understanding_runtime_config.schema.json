{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeleton.local/schemas/video_understanding_runtime_config.schema.json",
  "title": "Skeleton Video Understanding Private Runtime Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_root",
    "queue_root",
    "temp_root",
    "approved_local_roots",
    "local_media_registry",
    "direct_media_allowed_hosts",
    "executables",
    "ollama_transport",
    "ollama_model"
  ],
  "properties": {
    "artifact_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "queue_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "temp_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "approved_local_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "local_media_registry": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": {"pattern": "^[A-Za-z0-9_-]{16,128}$"},
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "direct_media_allowed_hosts": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 253}
    },
    "executables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yt_dlp", "ffmpeg", "ffprobe", "sona", "ocr"],
      "properties": {
        "yt_dlp": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"},
        "ffmpeg": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"},
        "ffprobe": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"},
        "sona": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"},
        "ocr": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"}
      }
    },
    "ollama_transport": {"enum": ["loopback", "private_bridge"]},
    "ollama_model": {"type": "string", "minLength": 1, "maxLength": 256},
    "ollama_endpoint": {"type": ["string", "null"], "maxLength": 4096},
    "sona_endpoint": {"type": "string", "maxLength": 4096},
    "sona_model": {"type": "string", "minLength": 1, "maxLength": 256},
    "sona_start_args": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "subtitle_languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{2,16}$"}
    },
    "ocr_languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{2,16}$"}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_download_bytes": {"type": "integer", "minimum": 1048576},
        "max_transcript_chars": {"type": "integer", "minimum": 1000},
        "max_frames": {"type": "integer", "minimum": 1, "maximum": 500},
        "max_ocr_chars_per_frame": {"type": "integer", "minimum": 100},
        "max_redirects": {"type": "integer", "minimum": 0, "maximum": 10},
        "subprocess_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "subprocess_output_bytes": {"type": "integer", "minimum": 1024},
        "lease_seconds": {"type": "integer", "minimum": 30},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    }
  }
}
