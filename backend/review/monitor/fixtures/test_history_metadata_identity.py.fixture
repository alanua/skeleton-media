"""Execute actual app functions with synthetic stubs; never import app/discovery."""
import ast
import copy
import difflib
from pathlib import Path
import re
import time
import types
import unittest
from urllib.parse import urlparse
from unittest.mock import Mock

ROOT = Path(__file__).resolve().parents[1]


def load_enricher(discovery, page):
    names = {'_enrich_history_job_metadata', '_history_release_year', '_history_movie_identity', '_metadata_title_match', '_history_normalized_title'}
    tree = ast.parse((ROOT / 'backend/app.py').read_text())
    scope = dict(re=re, time=time, difflib=difflib, urlparse=urlparse,
                 media_discovery=discovery, resolver=types.SimpleNamespace(page_metadata=page),
                 _history_job_eligible=lambda j: True,
                 _history_display_title=lambda j: j['catalog'].get('title') or j['title'],
                 _history_normalized_title=lambda s: re.sub(r'\s*[\[(]\d{4}[\])]\s*$', '', s).strip(),
                 _job_media_type=lambda j: j.get('history_media_type', 'movie'),
                 _clean_history_overview=lambda s: s,
                 _history_overview_quality=lambda s: bool(s),
                 _infer_content_type=lambda j, t: t)
    nodes = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in names]
    exec(compile(ast.Module(body=nodes, type_ignores=[]), 'actual-app-functions', 'exec'), scope)
    return scope['_enrich_history_job_metadata']


class IdentityTests(unittest.TestCase):
    def run_case(self, title, year, candidate=None, *, catalog=None, job=None, network=True, page=None, canonical_details=None):
        d = types.SimpleNamespace(_normal=lambda s: re.sub(r'[^\w]+', ' ', str(s).casefold()).strip(),
            metadata_for_title=Mock(return_value=candidate or {}),
            metadata=Mock(return_value=canonical_details or {}),
            tmdb_ui_metadata=Mock(return_value={}), media_ratings_metadata=Mock(return_value={}),
            tmdb_work_details=Mock(return_value={}), tmdb_proxy_available=lambda: True,
            is_trailer_source=lambda s: False, tmdb_season_posters=Mock(return_value={}),
            tmdb_series_season_catalog=Mock(return_value=[]))
        p = Mock(return_value=page or {})
        original = dict(title=title, catalog=dict(title=title, year=year, **(catalog or {})),
                        sources=[{'url':'synthetic://source', 'episode':'2', 'voice':'uk', 'subtitle':'uk', 'position':42}],
                        hidden=True, position=12, page_url='')
        original.update(job or {})
        value = copy.deepcopy(original)
        result = load_enricher(d, p)(value, allow_network=network)
        self.assertEqual(result['sources'], original['sources'])
        self.assertEqual(result['hidden'], original['hidden'])
        self.assertEqual(result['position'], original['position'])
        return result, d, p

    def candidate(self, title, year, **kw):
        return dict(title=title, year=year, tmdb_id=900, media_type='movie', **kw)

    def test_numeric_title_release_years(self):
        for title, stale, actual in [('2001: A Space Odyssey',2001,1968),('1917',1917,2019),('2012',2012,2009),('2046',2046,2004)]:
            # Numeric-only titles need independent external identity corroboration.
            with self.subTest(title=title):
                result, d, _ = self.run_case(title,stale,self.candidate(title,actual,imdb_id='tt-known'),catalog={'imdb_id':'tt-known'})
                self.assertEqual(result['catalog']['year'],actual)
                self.assertEqual(result['catalog']['tmdb_id'],900)
                self.assertEqual(d.metadata_for_title.call_args.args[1],0)

    def test_explicit_year_and_suffix(self):
        for title, extras in [('1984', {'release_year':1984}),('Film (1984)', {}),('Film [1984]', {}),('Film - 1984', {})]:
            with self.subTest(title=title):
                result, d, _ = self.run_case(title,1984,self.candidate('1984' if title == '1984' else 'Film',1984),catalog=extras)
                self.assertEqual(result['catalog']['year'],1984)
                self.assertEqual(d.metadata_for_title.call_args.args[1],1984)

    def test_numeric_remake_without_corroboration_unresolved(self):
        r, _, _ = self.run_case('1984',1984,self.candidate('1984',1956))
        self.assertFalse(r['catalog'].get('tmdb_id'))

    def test_decoys(self):
        for candidate in [self.candidate('Other film',1968), self.candidate('2001: A Space Odyssey',1800),
                          self.candidate('2001: A Space Odyssey',9999),
                          self.candidate('2001: A Space Odyssey','bad'),
                          self.candidate('2001: A Space Odyssey',None),
                          self.candidate('2001: A Space O',1968),
                          dict(title='2001: A Space Odyssey',year=1968,tmdb_id=900,media_type='tv'),
                          self.candidate('2001: A Space Odyssey',1968,imdb_id='tt-wrong')]:
            with self.subTest(candidate=candidate):
                r,_,_ = self.run_case('2001: A Space Odyssey',2001,candidate,catalog={'imdb_id':'tt-known'})
                self.assertFalse(r['catalog'].get('tmdb_id'))

    def test_explicit_wrong_year_rejected(self):
        r,_,_ = self.run_case('1984',1984,self.candidate('1984',1956),catalog={'release_year':1984})
        self.assertFalse(r['catalog'].get('tmdb_id'))

    def test_malformed_and_out_of_range(self):
        for year in ['garbage', {}, 1800, 9999]:
            with self.subTest(year=year):
                r,_,_ = self.run_case('Film',year,self.candidate('Film',1968))
                self.assertEqual(r['catalog']['year'],1968)

    def test_translated_original_aliases(self):
        r,_,_ = self.run_case('Космічна одіссея 2001',2001,
            self.candidate('2001: A Space Odyssey',1968,original_title='2001: A Space Odyssey'),
            catalog={'original_title':'2001: A Space Odyssey'})
        self.assertEqual(r['catalog']['year'],1968)
        self.assertEqual(r['catalog']['tmdb_id'],900)

    def test_no_result(self):
        r,_,_ = self.run_case('2001: A Space Odyssey',2001)
        self.assertFalse(r['catalog'].get('tmdb_id'))
        self.assertIsNone(r['catalog']['year'])

    def test_canonical_untouched(self):
        r,d,_ = self.run_case('2001: A Space Odyssey',1968,self.candidate('Wrong',2001),
            catalog={'tmdb_id':62,'media_uid':'canonical','poster':'canonical.jpg','imdb_rating':8.3})
        self.assertEqual(r['catalog']['tmdb_id'],62)
        self.assertEqual(r['catalog']['media_uid'],'canonical')
        self.assertEqual(r['catalog']['year'],1968)
        self.assertEqual(r['catalog']['poster'],'canonical.jpg')
        self.assertEqual(r['catalog']['imdb_rating'],8.3)
        d.metadata_for_title.assert_not_called()

    def test_canonical_missing_artwork_refills_by_existing_id(self):
        details = dict(tmdb_id=62, media_type='movie', year=1968,
                       poster='https://synthetic.invalid/canonical.jpg', overview='Canonical synopsis')
        result, discovery, _ = self.run_case('2001: A Space Odyssey', None,
            catalog={'tmdb_id':62, 'media_uid':'KEEP'}, canonical_details=details)
        self.assertEqual(result['catalog']['tmdb_id'], 62)
        self.assertEqual(result['catalog']['media_uid'], 'KEEP')
        self.assertEqual(result['catalog']['year'], 1968)
        self.assertEqual(result['catalog']['poster'], details['poster'])
        self.assertEqual(result['catalog']['overview'], details['overview'])
        discovery.metadata.assert_called_once_with('https://www.themoviedb.org/movie/62')
        discovery.metadata_for_title.assert_not_called()

    def test_wrong_canonical_detail_cannot_fill_or_change_identity(self):
        for wrong in [{'tmdb_id':900,'media_type':'movie'}, {'tmdb_id':62,'media_type':'tv'}]:
            result, discovery, _ = self.run_case('Known film',1968,
                catalog={'tmdb_id':62,'media_uid':'KEEP'},
                canonical_details={**wrong,'poster':'wrong.jpg','year':2001})
            self.assertEqual(result['catalog']['tmdb_id'],62)
            self.assertEqual(result['catalog']['year'],1968)
            self.assertFalse(result['catalog']['poster'])
            discovery.metadata_for_title.assert_not_called()

    def test_offline_canonical_missing_artwork_does_not_fetch(self):
        _, discovery, _ = self.run_case('Known film',1968,
            catalog={'tmdb_id':62}, network=False)
        discovery.metadata.assert_not_called()
        discovery.metadata_for_title.assert_not_called()

    def test_invalid_explicit_calendar_date_does_not_supply_year(self):
        result, _, _ = self.run_case('Synthetic film',None,
            catalog={'release_date':'2026-02-30'})
        self.assertIsNone(result['catalog']['year'])

    def test_tv_later_season(self):
        calls=[]
        def lookup(t,y,k):
            calls.append(y)
            return {} if y else dict(title='Fargo',year=2014,media_type='tv',tmdb_id=606)
        d = types.SimpleNamespace(_normal=lambda s:s.casefold(),metadata_for_title=lookup,
            tmdb_ui_metadata=lambda *a,**k:{},media_ratings_metadata=lambda *a,**k:{},tmdb_work_details=lambda *a,**k:{},
            tmdb_series_season_catalog=lambda *a,**k:[],is_trailer_source=lambda s:False)
        r=load_enricher(d,Mock())({'title':'Fargo','catalog':{'title':'Fargo','year':2023},'history_media_type':'tv','sources':[]})
        self.assertEqual(calls,[2023,0]);self.assertEqual(r['catalog']['year'],2014)

    def test_network_false(self):
        r,d,p = self.run_case('Film','bad',self.candidate('Film',1968),network=False,job={'page_url':'https://fixture.invalid'})
        d.metadata_for_title.assert_not_called();p.assert_not_called()

    def test_page_explicit_date(self):
        r,_,_=self.run_case('1984',1984,self.candidate('1984',1956),
            job={'page_url':'https://fixture.invalid'},page={'title':'1984','release_date':'1956-06-08'})
        self.assertEqual(r['catalog']['year'],1956)
        self.assertEqual(r['catalog']['tmdb_id'],900)

    def test_structured_page_year_confirms_numeric_title(self):
        r, d, _ = self.run_case('1984',1984,self.candidate('1984',1984),
            job={'page_url':'https://fixture.invalid'},page={'title':'1984','year':1984})
        self.assertEqual(r['catalog']['year'],1984)
        self.assertEqual(r['catalog']['tmdb_id'],900)
        self.assertEqual(d.metadata_for_title.call_args.args[1],1984)

    def test_identity_without_numeric_stale_year(self):
        r,_,_=self.run_case('2001: A Space Odyssey',None,self.candidate('2001: A Space Odyssey',1968))
        self.assertEqual(r['catalog']['year'],1968)
        self.assertEqual(r['catalog']['tmdb_id'],900)

    def test_network_false_tv_no_season_fetch(self):
        r,d,p=self.run_case('Fargo',2014,network=False,
            catalog={'tmdb_id':606},job={'history_media_type':'tv', 'sources':[{'season':'4','episode':'2'}]})
        d.metadata_for_title.assert_not_called()
        d.tmdb_season_posters.assert_not_called()
        self.assertFalse(d.tmdb_ui_metadata.call_args.kwargs['allow_network'])
        self.assertFalse(d.tmdb_series_season_catalog.call_args.kwargs['allow_network'])

